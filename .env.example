# ── Phase 0: foundation ───────────────────────────────────────────────
# Supabase project (Postgres + Auth). Used by packages/auth and packages/db.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pooled Postgres connection string (Supabase Dashboard → Project Settings →
# Database → Connection string → "Transaction" mode / Supavisor, port 6543).
# Used by the app at runtime (packages/db's getDb()) — required on serverless
# hosting to avoid exhausting Supabase's direct connection limit under
# concurrent requests. Same database as the Supabase project above.
DATABASE_URL=

# Direct (non-pooled) Postgres connection string (same page, "Session" mode /
# direct connection, port 5432). Used only by Drizzle Kit for migrations
# (packages/db/drizzle.config.ts) — falls back to DATABASE_URL if unset, but
# migrations against a transaction-mode pooler are not reliable, so set this
# separately once available.
DIRECT_URL=

# Inngest (event/workflow client). Local dev: run `npx inngest-cli dev` and
# these can stay blank. Production: values come from the Inngest Cloud
# dashboard once the app is deployed there.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Marketing Intelligence Engine — connection (MIE-1) ──────────────────
# Google Cloud OAuth client (Internal/Testing publishing status — avoids
# Google's app verification review since the founder is the only user).
# Enable the Google Ads API, GA4 Data/Admin API, Tag Manager API, and
# Search Console API on the project before connecting.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth client, e.g.
# http://localhost:3001/api/marketing/oauth/callback for local dev.
GOOGLE_OAUTH_REDIRECT_URI=

# 32 raw bytes, base64-encoded — encrypts the stored Google refresh token.
# Generate with: openssl rand -base64 32
MARKETING_TOKEN_ENCRYPTION_KEY=

# Google Ads API: developer token (secret) and optional manager login-customer-id
# Obtain a developer token from your Google Ads Manager Center and keep it secret.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional: when using an MCC developer token, set the manager login-customer-id (e.g. 123-456-7890)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ── Marketing Intelligence Engine — detection (MIE-2) ───────────────────
# Server-side Claude API key for strategist synthesis (daily audit + weekly
# report). Separate from whatever authenticates Claude Code in dev — this
# is the deployed app calling the Claude API on its own. Get one at
# https://console.anthropic.com.
ANTHROPIC_API_KEY=

# Resend — critical alert emails + weekly digest. Needs a verified sending
# domain in Resend for the `from` address to work.
RESEND_API_KEY=
# Where critical alerts and the weekly digest are sent.
MARKETING_ALERT_EMAIL=
# Optional override — must be on a domain verified in Resend.
# MARKETING_ALERT_FROM_EMAIL="Bonolini Marketing Intelligence <alerts@yourdomain.com>"

# Comma-separated URLs the engine checks for uptime/response time/indexing
# (landing_page_availability, page_speed, search_console_indexing checks).
# No UI to manage this list yet.
MARKETING_MONITORED_URLS=http://localhost:3000/,http://localhost:3000/request-quote

# ── transfer-web tracking ────────────────────────────────────────────────
# GTM container public ID (GTM-XXXXXXX). Installs the GTM snippet on
# transfer-web — without this, there's no tracking on the site for the
# engine to check at all.
NEXT_PUBLIC_GTM_CONTAINER_ID=

# ── GA4 Measurement Protocol (server-side "generate_lead" event) ────────
# Sends the generate_lead event server-side on a successful lead write,
# instead of via GTM — the live GTM container (GTM-58GJWMF7) has no trigger
# for it and this app's OAuth connection is read-only, so it can't add one.
# See packages/core/src/marketing/measurement-protocol.ts for the full
# rationale. Fails soft (no event sent, no error) if either is unset.
# The property's data stream ID (GA4 Admin → Data Streams → stream details).
GA4_MEASUREMENT_ID=
# Create once, manually, in GA4 Admin → Data Streams → that stream →
# Measurement Protocol API secrets — cannot be created via the existing
# (analytics.readonly) OAuth connection.
GA4_MEASUREMENT_PROTOCOL_API_SECRET=

# ── WhatsApp → BOS integration (Phase 1: inbound message ingestion) ────
# Meta App Secret (App Dashboard → Settings → Basic) — used to verify the
# X-Hub-Signature-256 header on every inbound webhook POST. Never logged.
WHATSAPP_APP_SECRET=
# Arbitrary string you choose, entered in the Meta App Dashboard's webhook
# subscription form — used only for the GET verification challenge.
WHATSAPP_VERIFY_TOKEN=
# Outbound WhatsApp Cloud API (packages/core/src/communications). Without
# both, every outbound send is recorded as execution_failed, never faked.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: a Meta-approved, parameter-less template used for customers
# outside the 24h window. Leave empty to fail explicitly instead.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=

# ── quote-approval: PREVENTIVO PRONTO -> APPROVA / MODIFICA / RIFIUTA ───
# Master switch: anything but "true" = flow off, webhook behaves as before.
QUOTE_APPROVAL_ENABLED=
# Test mode: if set, the flow only acts for these customer numbers (E.164,
# comma separated). Everyone else gets nothing automatic. Set but with no
# valid number = nobody. Leave empty to open the flow to all customers.
QUOTE_APPROVAL_TEST_PHONES=
# Founder notifications go by email (Resend: RESEND_API_KEY and optionally
# MARKETING_ALERT_FROM_EMAIL above) to this address; empty = MARKETING_ALERT_EMAIL.
FOUNDER_NOTIFICATION_EMAIL=
# Admin panel address, for the links in those emails.
ADMIN_BASE_URL=https://bonolini-operating-system-transfer.vercel.app
# Optional, normally EMPTY: a separate founder WhatsApp number would turn on
# WhatsApp buttons (APPROVA/MODIFICA/RIFIUTA) as an alternative to the panel.
# Empty = email + admin panel only, no WhatsApp to the founder ever.
FOUNDER_WHATSAPP_PHONE=
# Only with FOUNDER_WHATSAPP_PHONE: the founder's profiles.id (role admin),
# recorded as approver for WhatsApp approvals. The panel uses the logged-in user.
FOUNDER_PROFILE_ID=

# ── maps-distance: Google Maps route distance/duration ──────────────────
# Google Maps Platform API key with the Routes API enabled (not the legacy
# Distance Matrix API the old CChiefGrowthAI bot used — same kind of key,
# different product to enable on the Google Cloud project). Used only by
# packages/core/src/maps-distance, called by transfer-requests when (and
# only when) calculatePrice() itself reports a route needs a real distance.
GOOGLE_MAPS_API_KEY=

# ── social-publishing: automated weekly Facebook Page post ─────────────
# Reuses the same Meta App already used for WhatsApp (see
# WHATSAPP_APP_SECRET above) — add the "Facebook Login for Business"
# product to it and request pages_manage_posts + pages_show_list on the
# Bonolini Transfer Page, then exchange a user token for a long-lived Page
# Access Token (Graph API Explorer: short-lived user token -> long-lived
# user token -> Page Access Token). This does not expire on its own; it is
# a plain env var, not stored in the database (see
# packages/core/src/social-publishing/README.md's "Credential model"
# section for why no DB-level encryption is used here, unlike
# MARKETING_TOKEN_ENCRYPTION_KEY above).
# NOT YET CONFIGURED — pending the founder's code review (2026-09).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ── social-publishing: same weekly post, also to Instagram ─────────────
# Same Meta App and FACEBOOK_PAGE_ACCESS_TOKEN as above — no separate
# Instagram token to configure. On top of pages_manage_posts +
# pages_show_list, also request instagram_basic + instagram_content_publish
# on the same Page in Graph API Explorer, then re-exchange the Page Access
# Token above so it carries the new scopes (a token issued before adding a
# permission does not gain it retroactively). The Bonolini Transfer
# Instagram account must already be an Instagram **Business or Creator**
# account linked to the Facebook Page (Meta Business Suite → Instagram
# accounts) — a personal Instagram account cannot be published to via this
# API at all.
# Find the id: GET /{FACEBOOK_PAGE_ID}?fields=instagram_business_account
# in Graph API Explorer, using the Page Access Token above.
# A permanent, publicly reachable HTTPS URL to a real, already-published
# official Bonolini Transfer photo — Instagram has no text-only post type,
# so this is mandatory for every Instagram publish (see
# packages/core/src/social-publishing/meta-client.ts's publishInstagramPost).
# Never a placeholder, stock photo, or AI-generated image: copy the "src" of
# a photo already posted on the Bonolini Transfer Facebook/Instagram Page,
# or a real photo once transfer-web serves one from its own public assets.
# When unset, Instagram publishing is skipped (not treated as an error) —
# Facebook keeps publishing as before; see the module's README.md.
# NOT YET CONFIGURED — pending the founder's code review (2026-09).
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_POST_IMAGE_URL=

# ── Phase 1+: added when the corresponding domain module is built ──────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
